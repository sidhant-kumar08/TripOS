{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "src",
  "testRegex": ".spec.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "collectCoverageFrom": [
    "**/*.ts",
    "!**/*.spec.ts",
    "!**/node_modules/**"
  ]
}
